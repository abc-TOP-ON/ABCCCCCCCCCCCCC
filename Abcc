local function createSidebarButton(text, posIndex, isActive)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -20, 0, 35)
    Btn.Position = UDim2.new(0, 10, 0, 55 + ((posIndex - 1) * 40))
    
    if isActive then
        Btn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    Btn.BorderSizePixel = 0
    Btn.Text = text
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamBold
    Btn.Parent = Sidebar
    Btn.ZIndex = 17

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn
    
    Btn.MouseEnter:Connect(function()
        if not isActive then
            Btn.BackgroundColor3 = Color3.fromRGB(70, 70, 95)
        end
    end)
    Btn.MouseLeave:Connect(function()
        if not isActive then
            Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
        end
    end)
    
    if isActive then
        local Indicator = Instance.new("Frame")
        Indicator.Size = UDim2.new(0, 3, 1, -10)
        Indicator.Position = UDim2.new(0, 3, 0, 5)
        Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Indicator.BorderSizePixel = 0
        Indicator.Parent = Btn
        Indicator.ZIndex = 18
    end
end

