    local player = game.Players.LocalPlayer
    local character = player.Character
    
    if not character or not character:FindFirstChild("Humanoid") then
        showNotification("⚠️ ما لقيت شخصيتك!", CarFrame)
        return
    end
    
    local seat = character.Humanoid.SeatPart
    
    if not seat then
        showNotification("⚠️ لازم تركب سيارة أولاً!", CarFrame)
        return
    end
    
    local vehicle = seat.Parent
    
    if not vehicle or not vehicle:IsA("Model") then
        showNotification("⚠️ ما لقيت السيارة!", CarFrame)
        return
    end
    
    local PrimaryPart = vehicle.PrimaryPart
    
    if not PrimaryPart then
        for _, child in pairs(vehicle:GetDescendants()) do
            if child:IsA("BasePart") and child.Name ~= "Seat" and child.Name ~= "DriveSeat" then
                PrimaryPart = child
                break
            end
        end
    end
    
    if not PrimaryPart then
        PrimaryPart = seat
    end
    
    if not PrimaryPart then
        showNotification("⚠️ ما لقيت جزء أساسي للسيارة!", CarFrame)
        return
    end
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 200, 0)
    bodyVelocity.MaxForce = Vector3.new(0, 1000000, 0)
    bodyVelocity.Parent = PrimaryPart
    
    local bodyForce = Instance.new("BodyForce")
    bodyForce.Force = Vector3.new(0, PrimaryPart:GetMass() * 196.2, 0)
    bodyForce.Parent = PrimaryPart
    
    local currentPos = PrimaryPart.Position
    PrimaryPart.CFrame = CFrame.new(currentPos + Vector3.new(0, 15, 0))
    
    task.wait(1.5)
    bodyVelocity:Destroy()
    bodyForce:Destroy()
    
    showNotification("🚀 تم قفز السيارة للأعلى!", CarFrame)
end)

