local ActiveHighlights = {}

local function applyVisual(char)
    if not char or char:FindFirstChild("DevVisual") then return end

    local marker = Instance.new("BoolValue")
    marker.Name = "DevVisual"
    marker.Parent = char

    local highlight = Instance.new("Highlight")
    highlight.Name = "DevHighlight"
    highlight.Parent = char
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0

    table.insert(ActiveHighlights, highlight)

    local head = char:FindFirstChild("Head")

    if head then
        local tag = Instance.new("BillboardGui")
        tag.Size = UDim2.new(0,120,0,40)
        tag.StudsOffset = Vector3.new(0,2.5,0)
        tag.Adornee = head
        tag.Parent = head

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1,0,1,0)
        txt.BackgroundTransparency = 1
        txt.TextScaled = true
        txt.Text = char.Name
        txt.TextColor3 = Color3.new(1,1,1)
        txt.Parent = tag

        RunService.RenderStepped:Connect(function()
            tag.Enabled = Settings.Names
        end)
    end
end

-- =========================
-- HIGHLIGHT CONTROLLER (FIXED ON/OFF + COLOR)
-- =========================
RunService.RenderStepped:Connect(function()
    for i = #ActiveHighlights, 1, -1 do
        local h = ActiveHighlights[i]

        if not h or not h.Parent then
            table.remove(ActiveHighlights, i)
        else
            h.Enabled = Settings.HighlightEnabled

            if Settings.HighlightEnabled then
                h.FillColor = Settings.HighlightColor
                h.OutlineColor = Settings.HighlightColor
            else
                h.Enabled = false
            end
        end
    end
end)

