SpinSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local x = math.clamp((input.Position.X - SpinSlider.AbsolutePosition.X) / SpinSlider.AbsoluteSize.X, 0, 1)
        SpinSliderFill.Size = UDim2.new(x, 0, 1, 0)
        spinSpeed = x
        SpinValueLabel.Text = math.floor(x * 100) .. "%"
        
        if x < 0.3 then
            SpinSpeedLabel.Text = "⚡ سرعة الدوران: بطيء"
        elseif x < 0.6 then
            SpinSpeedLabel.Text = "⚡ سرعة الدوران: متوسط"
        else
            SpinSpeedLabel.Text = "⚡ سرعة الدوران: سريع"
        end
    end
end)

SpinSlider.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if input.UserInputState == Enum.UserInputState.Begin or input.UserInputState == Enum.UserInputState.Change then
            local x = math.clamp((input.Position.X - SpinSlider.AbsolutePosition.X) / SpinSlider.AbsoluteSize.X, 0, 1)
            SpinSliderFill.Size = UDim2.new(x, 0, 1, 0)
            spinSpeed = x
            SpinValueLabel.Text = math.floor(x * 100) .. "%"
            
            if x < 0.3 then
                SpinSpeedLabel.Text = "⚡ سرعة الدوران: بطيء"
            elseif x < 0.6 then
                SpinSpeedLabel.Text = "⚡ سرعة الدوران: متوسط"
            else
                SpinSpeedLabel.Text = "⚡ سرعة الدوران: سريع"
            end
        end
    end
end)

SpinButton.MouseButton1Down:Connect(function()
    SpinButton.BackgroundColor3 = Color3.fromRGB(255, 100, 200)
end)

SpinButton.MouseLeave:Connect(function()
    SpinButton.BackgroundColor3 = Color3.fromRGB(200, 50, 150)
end)

SpinButton.MouseButton1Click:Connect(function()
    if isSpinning then return end
    isSpinning = true
    
    local char = LocalPlayer.Character
    if not char then
        showNotification("❌ ما لقيت الشخصية!", SpinFrame)
        isSpinning = false
        return
    end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        showNotification("❌ ما لقيت الـ HumanoidRootPart!", SpinFrame)
        isSpinning = false
        return
    end
    
    local duration = 0.8 / (spinSpeed + 0.1)
    local rotations = 3 + spinSpeed * 2
    
    showNotification("🔄 جاري الدوران...", SpinFrame)
    
    local startCF = root.CFrame
    local endCF = startCF * CFrame.Angles(0, math.rad(360 * rotations), 0)
    
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = endCF
    })
    
    tween:Play()
    tween.Completed:Connect(function()
        isSpinning = false
        showNotification("✅ تم الدوران!", SpinFrame)
    end)
    
    task.wait(duration + 0.1)
    if isSpinning then
        isSpinning = false
    end
end)

