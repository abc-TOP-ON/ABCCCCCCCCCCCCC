-- AIM ASSIST (TRAINING SAFE)
-- =========================
local function getClosest()
    local closest, dist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)

            if onScreen then
                local d = (Vector2.new(pos.X,pos.Y) - Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)).Magnitude
                if d < Settings.FOV and d < dist then
                    closest = plr
                    dist = d
                end
            end
        end
    end

    return closest
end

RunService.RenderStepped:Connect(function()
    if Settings.AimAssist and rightClick then
        local t = getClosest()
        if t and t.Character then
            local root = t.Character:FindFirstChild("HumanoidRootPart")
            if root then
                camera.CFrame = camera.CFrame:Lerp(
                    CFrame.new(camera.CFrame.Position, root.Position),
                    Settings.AimStrength
                )
            end
        end
    end
end)

