local buttonY = 0.06
local buttonHeight = 0.065
local buttonSpacing = 0.01
local buttonWidth = 0.45
local col1X = 0.03
local col2X = 0.52

local function createPlayerAdvButton(text, col, row, color, clickFunc)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(buttonWidth, 0, buttonHeight, 0)
    btn.Position = UDim2.new(col, 0, buttonY + (row * (buttonHeight + buttonSpacing)), 0)
    btn.BackgroundColor3 = color or Color3.fromRGB(60, 40, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.Parent = PlayerAdvFrame
    btn.ZIndex = 7
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.new(
            math.min(color.R + 0.15, 1),
            math.min(color.G + 0.15, 1),
            math.min(color.B + 0.15, 1)
        )
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = color
    end)
    
    if clickFunc then
        btn.MouseButton1Click:Connect(clickFunc)
    end
    
    return btn
end

