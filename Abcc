-- استدعاء الخدمات الأساسية
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local localPlayer = Players.LocalPlayer

-- متغيرات التحكم
_G.AutoPlay = false
local SpeedBoost = 32

-- [[ إنشاء واجهة المستخدم تلقائياً ]]
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local TextLabel = Instance.new("TextLabel")
local ToggleButton = Instance.new("TextButton")
local UICorner_Frame = Instance.new("UICorner")
local UICorner_Button = Instance.new("UICorner")

ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false

MainFrame.Name = "DeltaAI_Frame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.Position = UDim2.new(0.4, 0, 0.4, 0)
MainFrame.Size = UDim2.new(0, 220, 0, 130)
MainFrame.Active = true

UICorner_Frame.CornerRadius = UDim.new(0, 10)
UICorner_Frame.Parent = MainFrame

TextLabel.Parent = MainFrame
TextLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.BackgroundTransparency = 1.000
TextLabel.Size = UDim2.new(1, 0, 0, 40)
TextLabel.Font = Enum.Font.GothamBold
TextLabel.Text = "BOMB CHASER AI 🤖"
TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
TextLabel.TextSize = 16.000

ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = MainFrame
ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
ToggleButton.Position = UDim2.new(0.05, 0, 0.45, 0)
ToggleButton.Size = UDim2.new(0.9, 0, 0, 45)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Text = "تفعيل (OFF)"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 16.000

UICorner_Button.CornerRadius = UDim.new(0, 8)
UICorner_Button.Parent = ToggleButton

-- [[ كود السحب والتحرك للواجهة ]]
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- [[ منطق زر التشغيل ]]
ToggleButton.MouseButton1Click:Connect(function()
    _G.AutoPlay = not _G.AutoPlay
    if _G.AutoPlay then
        ToggleButton.Text = "تشغيل (ON)"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        startAI()
    else
        ToggleButton.Text = "تفعيل (OFF)"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
            localPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

-- [[ ميكانيكية التحقق من القنبلة ]]
local function iHaveBomb()
    if localPlayer.Character then
        -- فحص الحقيبة أو اليد بحثاً عن القنبلة أو أي أداة مفعلة
        if localPlayer.Character:FindFirstChild("Bomb") or localPlayer.Character:FindFirstChildOfClass("Tool") or localPlayer.Backpack:FindFirstChild("Bomb") then
            return true
        end
    end
    return false
end

-- [[ البحث عن أقرب لاعب حي وتجاهل الموتى ]]
local function getClosestLivingPlayer()
    local closestTarget = nil
    local shortestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local distance = (localPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestTarget = player.Character.HumanoidRootPart
                end
            end
        end
    end
    return closestTarget
end

function startAI()
    task.spawn(function()
        -- نظام القفز التلقائي المدمج لفك التعليق أثناء الملاحقة
        task.spawn(function()
            while _G.AutoPlay do
                pcall(function()
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                        local humanoid = localPlayer.Character.Humanoid
                        local root = localPlayer.Character.HumanoidRootPart
                        
                        -- القفز إذا تعثر اللاعب بجدار أثناء الجري
                        if root.Velocity.Magnitude < 5 and humanoid.MoveDirection.Magnitude > 0 then
                            humanoid.Jump = true
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)

        -- حلقة الملاحقة الرئيسية
        while _G.AutoPlay do
            pcall(function()
                if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                    local humanoid = localPlayer.Character.Humanoid
                    local myRoot = localPlayer.Character.HumanoidRootPart
                    
                    if iHaveBomb() then
                        -- الحالة الوحيدة للحركة: القنبلة معك -> ملاحقة فوتومترية لأقرب لاعب حي
                        humanoid.WalkSpeed = SpeedBoost
                        local target = getClosestLivingPlayer()
                        if target then
                            humanoid:MoveTo(target.Position)
                            
                            -- تفعيل الأداة تلقائياً عند الاقتراب لرمي القنبلة
                            local tool = localPlayer.Character:FindFirstChildOfClass("Tool")
                            if tool then tool:Activate() end
                        end
                    else
                        -- القنبلة ليست معك -> إلغاء أي أوامر حركة والوقوف تماماً في مكانك
                        humanoid:MoveTo(myRoot.Position)
                        humanoid.WalkSpeed = 16 -- إعادة السرعة للطبيعية أثناء الانتظار
                    end
                end
            end)
            task.wait(0.05) -- استجابة سريعة جداً للحاق بالخصوم
        end
    end)
end
