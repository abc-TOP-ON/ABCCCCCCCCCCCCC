    notifCorner.Parent = notif
    
    task.wait(1.5)
    notif:Destroy()
end

-- حلقة الطيران
local function StartFlyLoop()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    flyConnection = RunService.Heartbeat:Connect(function()
        if Flying then
            local car = GetVehicle()
            if car then
                local PrimaryPart = car.PrimaryPart or car:FindFirstChildWhichIsA("BasePart")
                if PrimaryPart then
                    local cam = workspace.CurrentCamera
                    local lookVector = cam.CFrame.LookVector
                    
                    local moveDirection = Vector3.new(0, 0, 0)
                    if MovingForward then
                        moveDirection = lookVector * FlySpeed
                    end
                    
                    local currentPos = PrimaryPart.Position
                    local nextPos = currentPos + moveDirection
                    
                    PrimaryPart.CFrame = CFrame.new(nextPos, nextPos + Vector3.new(lookVector.X, 0, lookVector.Z))
                    PrimaryPart.Velocity = Vector3.new(0, 0, 0)
                    PrimaryPart.RotVelocity = Vector3.new(0, 0, 0)
                end
            else
                Flying = false
                MovingForward = false
                FlyToggleButton.Text = "✈️ الطيران: مطفأ"
                FlyToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                MoveCarButton.Text = "⏹️ الحركة: متوقفة"
                MoveCarButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                showNotification("⚠️ فقدت السيارة!", CarFrame)
            end
        end
    end)
end

