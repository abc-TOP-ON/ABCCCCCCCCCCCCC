local function UpdatePlayerList()
    for _, child in pairs(PlayerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local allPlayers = Players:GetPlayers()
    local searchText = SearchBox.Text:lower()
    local yOffset = 5
    local buttonHeight = 35
    local spacing = 5
    local shownCount = 0
    
    for i, player in ipairs(allPlayers) do
        local displayName = player.DisplayName:lower()
        local username = player.Name:lower()
        
        if searchText == "" or displayName:find(searchText) or username:find(searchText) then
            local isLocal = (player == LocalPlayer)
            shownCount = shownCount + 1
            
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(0.92, 0, 0, buttonHeight)
            button.Position = UDim2.new(0.04, 0, 0, yOffset)
            
            if isLocal then
                button.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
            else
                button.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            end
            
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.TextSize = 13
            button.Font = Enum.Font.GothamSemibold
            
            if isLocal then
                button.Text = "⭐ " .. player.DisplayName .. " (أنت)"
            else
                button.Text = "👤 " .. player.DisplayName .. " @" .. player.Name
            end
            
            button.Parent = PlayerScroll
            button.ZIndex = 7
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 6)
            corner.Parent = button
            
            button.MouseEnter:Connect(function()
                if not isLocal then
                    button.BackgroundColor3 = Color3.fromRGB(70, 70, 95)
                end
            end)
            button.MouseLeave:Connect(function()
                if not isLocal then
                    button.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
                end
            end)
            
            if not isLocal then
                button.MouseButton1Click:Connect(function()
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame
                        end
                    end
                end)
            end
            
            yOffset = yOffset + buttonHeight + spacing
        end
    end
    
    PlayerCountLabel.Text = "👥 " .. shownCount .. " لاعب" .. (shownCount > 1 and "ين" or "") .. (searchText ~= "" and " (نتائج البحث)" or " في السيرفر")
    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
end

