-- وظيفة القفز العالي جداً للسيارة
QuickFlyButton.MouseButton1Click:Connect(function()
    QuickFlyButton.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    
    -- جلب اللاعب والشخصية
    local player = game.Players.LocalPlayer
    local character = player.Character
    
    if not character or not character:FindFirstChild("Humanoid") then
        showNotification("⚠️ ما لقيت شخصيتك!", CarFrame)
        return
    end
    
    -- جلب المقعد اللي راكبه
    local seat = character.Humanoid.SeatPart
    
    if not seat then
        showNotification("⚠️ لازم تركب سيارة أولاً!", CarFrame)
        return
    end
    
    -- جلب السيارة (الأب الأعلى للمقعد)
    local vehicle = seat.Parent
    
    if not vehicle or not vehicle:IsA("Model") then
        showNotification("⚠️ ما لقيت السيارة!", CarFrame)
        return
    end
    
    -- نجيب جميع الأجزاء الأساسية للسيارة
    local parts = {}
    for _, child in pairs(vehicle:GetDescendants()) do
        if child:IsA("BasePart") then
            table.insert(parts, child)
        end
    end
    
    if #parts == 0 then
        showNotification("⚠️ ما لقيت أجزاء للسيارة!", CarFrame)
        return
    end
    
    -- ===== قفزة عالية جداً بقوة 400 =====
    for _, part in pairs(parts) do
        -- BodyVelocity لكل جزء
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 400, 0)  -- قوة القفز العالية جداً
        bodyVelocity.MaxForce = Vector3.new(0, 2000000, 0)  -- قوة قصوى عالية
        bodyVelocity.Parent = part
        
        -- BodyForce مساعد لكل جزء
        local bodyForce = Instance.new("BodyForce")
        bodyForce.Force = Vector3.new(0, part:GetMass() * 392.4, 0)  -- قوة مضاعفة
        bodyForce.Parent = part
        
        -- تغيير CFrame مباشر لقفزة فورية عالية
        local currentPos = part.Position
        part.CFrame = CFrame.new(currentPos + Vector3.new(0, 50, 0))  -- قفزة فورية 50 وحدة
    end
    
    -- إزالة القوى بعد 2 ثانية (عشان تثبت السيارة في الهواء)
    task.wait(2)
    for _, part in pairs(parts) do
        for _, child in pairs(part:GetChildren()) do
            if child:IsA("BodyVelocity") or child:IsA("BodyForce") then
                child:Destroy()
            end
        end
    end
    
    -- إشعار نجاح
    showNotification("🚀 تم قفز السيارة للأعلى بقوة عالية جداً!", CarFrame)
end)

